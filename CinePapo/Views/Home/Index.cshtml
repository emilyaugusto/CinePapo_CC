            color: var(--white-35);
            margin-top: .1rem;
        }
        .wl-badge {
            flex-shrink: 0;
            padding: .2rem .6rem;
            font-family: var(--font-head);
            font-size: .6rem;
            font-weight: 800;
            letter-spacing: .08em;
            text-transform: uppercase;
            border-radius: 3px;
        }
        .wb-want {
            background: rgba(232,81,2,.12);
            color: var(--orange);
            border: 1px solid rgba(232,81,2,.25);
        }
        .wb-done {
            background: rgba(16,185,129,.1);
            color: #10b981;
            border: 1px solid rgba(16,185,129,.2);
        }
        .wb-col {
            background: rgba(139,92,246,.1);
            color: #8b5cf6;
            border: 1px solid rgba(139,92,246,.2);
        }
        .wl__perks {
            display: flex;
            flex-direction: column;
            gap: .8rem;
            margin-top: .5rem;
        }
        .wl__perk {
            display: flex;
            gap: .9rem;
            align-items: flex-start;
            font-family: var(--font-ui);
            font-size: .85rem;
            color: var(--white-60);
        }
            .wl__perk i {
                color: var(--orange);
                font-size: .75rem;
                margin-top: .25rem;
                flex-shrink: 0;
            }
        /* ══════════  FRASE CINEMA ═════════════ */
        .cine-break {
            background: var(--orange);
            padding: 5rem 0;
            position: relative;
            overflow: hidden;
        }
            .cine-break::before {
                content: '◄◄◄◄◄◄◄◄◄◄◄◄◄◄◄◄◄◄◄';
                position: absolute;
                top: -1rem;
                left: 0;
                right: 0;
                font-family: var(--font-head);
                font-size: 6rem;
                font-weight: 900;
                color: rgba(0,0,0,.06);
                letter-spacing: .3em;
                white-space: nowrap;
                overflow: hidden;
                pointer-events: none;
                line-height: 1;
            }
        .cine-break__inner {
            position: relative;
            z-index: 2;
            text-align: center;
            max-width: 780px;
            margin: 0 auto;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 1.5rem;
        }
        .cine-break__quote {
            font-family: var(--font-head);
            font-size: clamp(2rem, 4.5vw, 4rem);
            font-weight: 900;
            text-transform: uppercase;
            line-height: .95;
            letter-spacing: -.02em;
            color: #fff;
        }
        .cine-break__attr {
            font-family: var(--font-ui);
            font-size: .8rem;
            letter-spacing: .1em;
            text-transform: uppercase;
            color: rgba(255,255,255,.6);
            display: flex;
            align-items: center;
            gap: 1rem;
        }
            .cine-break__attr::before, .cine-break__attr::after {
                content: '';
                width: 32px;
                height: 1px;
                background: rgba(255,255,255,.3);
            }
        .cine-break .btn {
            background: #fff;
            color: var(--orange);
        }
            .cine-break .btn:hover {
                background: rgba(255,255,255,.9);
            }
        /* ════════  COMO TRABALHAMOS ══════ */
        .hiw {
            padding: 8rem 0;
            background: var(--black-deep);
        }
        .hiw__head {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 1.2rem;
            margin-bottom: 0rem;
            max-width: 520px;
        }
        .hiw-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1px;
            background: var(--black-border);
            border: 1px solid var(--black-border);
            border-radius: var(--r-md);
            overflow: hidden;
        }
        @@media (max-width: 760px) {
            .hiw-grid {
                grid-template-columns: 1fr 1fr;
            }
        }
        @@media (max-width: 480px) {
            .hiw-grid {
                grid-template-columns: 1fr;
            }
        }
        .hiw-step {
            background: var(--black-card);
            padding: 2.2rem 1.8rem;
            position: relative;
            overflow: hidden;
            transition: background .3s;
        }
            .hiw-step:hover {
                background: var(--black-lift);
            }
        .hiw-step__n {
            font-family: var(--font-head);
            font-size: 4rem;
            font-weight: 900;
            line-height: 1;
            color: var(--orange);
            opacity: .15;
            margin-bottom: 1.2rem;
        }
        .hiw-step__title {
            font-family: var(--font-head);
            font-size: 1.1rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .04em;
            margin-bottom: .6rem;
        }
        .hiw-step__text {
            font-family: var(--font-ui);
            font-size: .82rem;
            color: var(--white-60);
            line-height: 1.6;
        }
        .hiw-step__bar {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: var(--orange);
            transform: scaleX(0);
            transform-origin: left;
            transition: transform .5s var(--ease-out);
        }
        .hiw-step:hover .hiw-step__bar {
            transform: scaleX(1);
        }
        /* ════════  FAQ ═════════ */
        .faq {
            padding: 8rem 0;
        }
        .faq__inner {
            display: grid;
            grid-template-columns: 1fr 1.6fr;
            gap: 5rem;
            align-items: start;
        }
        @@media (max-width: 760px) {
            .faq__inner {
                grid-template-columns: 1fr;
            }
        }
        .faq__left {
            position: sticky;
            top: 6rem;
        }
        .faq__left-head {
            display: flex;
            flex-direction: column;
            gap: 1.2rem;
            margin-bottom: 2rem;
        }
        .faq-list {
            display: flex;
            flex-direction: column;
            gap: 0;
        }
        .faq-it {
            border-bottom: 1px solid var(--black-border);
            overflow: hidden;
        }
            .faq-it:first-child {
                border-top: 1px solid var(--black-border);
            }
        .faq-q {
            width: 100%;
            text-align: left;
            padding: 1.3rem 0;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            font-family: var(--font-body);
            font-size: .92rem;
            font-weight: 600;
            color: var(--white-90);
            background: none;
            transition: color .2s;
        }
            .faq-q:hover {
                color: var(--orange);
            }
        .faq-it.open .faq-q {
            color: var(--orange);
        }
        .faq-ico {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            border: 1.5px solid var(--black-border);
            display: grid;
            place-items: center;
            font-size: .68rem;
            color: var(--white-35);
            flex-shrink: 0;
            transition: transform .35s var(--ease-back), border-color .2s, color .2s;
        }
        .faq-it.open .faq-ico {
            transform: rotate(45deg);
            border-color: var(--orange-border);
            color: var(--orange);
        }
        .faq-a {
            max-height: 0;
            overflow: hidden;
            transition: max-height .45s var(--ease-out);
        }
        .faq-it.open .faq-a {
            max-height: 280px;
        }
        .faq-a__in {
            padding: 0 0 1.3rem;
            font-family: var(--font-ui);
            font-size: .85rem;
            color: var(--white-60);
            line-height: 1.7;
        }
        /* ═════════ CTA FINAL ═════════════ */
        .fcta {
            background: var(--black-deep);
            border-top: 1px solid var(--black-border);
            padding: 8rem 0;
            position: relative;
            overflow: hidden;
        }
            .fcta::before {
                content: '';
                position: absolute;
                inset: 0;
                background: radial-gradient(ellipse 60% 70% at 50% 100%, rgba(232,81,2,.07) 0%, transparent 70%);
            }
        .fcta__inner {
            position: relative;
            z-index: 2;
            text-align: center;
            max-width: 640px;
            margin: 0 auto;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 1.8rem;
        }
        .fcta__title {
            font-family: var(--font-head);
            font-size: clamp(3.5rem, 7vw, 7rem);
            font-weight: 900;
            text-transform: uppercase;
            line-height: .9;
            letter-spacing: -.02em;
        }
            .fcta__title .t-o {
                color: var(--orange);
            }
            .fcta__title .t-outline {
                color: transparent;
                -webkit-text-stroke: 2px rgba(255,255,255,.2);
            }
        .fcta__sub {
            font-family: var(--font-ui);
            font-size: .95rem;
            color: var(--white-60);
            line-height: 1.7;
            max-width: 420px;
        }
        .fcta__btns {
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
            justify-content: center;
        }
            .fcta__btns .btn {
                padding: 1.1rem 2.8rem;
                font-size: .88rem;
            }
        .fcta__note {
            font-family: var(--font-ui);
            font-size: .72rem;
            color: var(--white-35);
            letter-spacing: .04em;
        }
        /* ═══════ FOOTER ═══════════════ */
        .footer {
            background: var(--black-deep);
            border-top: 1px solid var(--black-border);
            padding: 4.5rem 0 2.5rem;
        }
        .footer__grid {
            display: grid;
            grid-template-columns: 1.6fr 1fr 1fr 1fr;
            gap: 3rem;
            margin-bottom: 4rem;
        }
        @@media (max-width: 760px) {
            .footer__grid {
                grid-template-columns: 1fr 1fr;
            }
        }
        @@media (max-width: 480px) {
            .footer__grid {
                grid-template-columns: 1fr;
            }
        }
        .footer__brand-text {
            font-family: var(--font-ui);
            font-size: .82rem;
            color: var(--white-35);
            line-height: 1.65;
            max-width: 230px;
            margin-top: .9rem;
        }
        .footer__socials {
            display: flex;
            gap: .6rem;
            margin-top: 1.3rem;
        }
        .footer__social {
            width: 32px;
            height: 32px;
            border: 1px solid var(--black-border);
            border-radius: var(--r-xs);
            display: grid;
            place-items: center;
            font-size: .8rem;
            color: var(--white-35);
            transition: all .2s;
        }
            .footer__social:hover {
