            height: 50px;
            border-radius: 3px;
            flex-shrink: 0;
        }
        .wt1 {
            background: linear-gradient(135deg,#1a0d40,#0d0828);
        }
        .wt2 {
            background: linear-gradient(135deg,#400d0d,#1a0808);
        }
        .wt3 {
            background: linear-gradient(135deg,#0d3b1a,#081a0d);
        }
        .wt4 {
            background: linear-gradient(135deg,#2e1c00,#0a0800);
        }
        .wt5 {
            background: linear-gradient(135deg,#0d0d40,#08081a);
        }
        .wl-info {
            flex: 1;
            min-width: 0;
        }
        .wl-info__title {
            font-family: var(--font-head);
            font-size: .9rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .03em;
