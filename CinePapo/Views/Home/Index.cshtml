        }
        .feat-card__title {
            font-family: var(--font-head);
            font-size: 1.35rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .02em;
            margin-bottom: .6rem;
        }
        .feat-card__text {
            font-family: var(--font-ui);
            font-size: .84rem;
            color: var(--white-60);
            line-height: 1.65;
        }
        /* ══════COMUNIDADE═══════════════════ */
        .proof {
            padding: 7rem 0;
            background: var(--black-deep);
        }
        .proof__head {
            display: grid;
            grid-template-columns: 1fr 1fr;
            align-items: end;
            gap: 2rem;
            margin-bottom: 4rem;
        }
        @@media (max-width: 680px) {
            .proof__head {
                grid-template-columns: 1fr;
            }
        }
        .proof__right {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 1rem;
        }
        .proof-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 1px;
            background: var(--black-border);
            border: 1px solid var(--black-border);
            border-radius: var(--r-md);
            overflow: hidden;
        }
        .proof-card {
            background: var(--black-card);
            padding: 1.8rem;
            transition: background .3s;
        }
            .proof-card:hover {
                background: var(--black-lift);
            }
        .proof-card__stars {
            display: flex;
            gap: .15rem;
            margin-bottom: .9rem;
        }
            .proof-card__stars i {
                font-size: .72rem;
                color: var(--orange);
            }
        .proof-card__quote {
            font-family: var(--font-ui);
            font-size: .9rem;
            font-style: italic;
            color: var(--white-60);
            line-height: 1.6;
            margin-bottom: 1.4rem;
        }
        .proof-card__author {
            display: flex;
            align-items: center;
            gap: .75rem;
        }
        .proof-card__name {
            font-size: .84rem;
            font-weight: 600;
        }
        .proof-card__handle {
            font-size: .7rem;
            color: var(--white-35);
        }
        .proof__numbers {
            display: flex;
            flex-wrap: wrap;
            border-top: 1px solid var(--black-border);
            margin-top: 1px;
        }
        .proof__num {
            flex: 1;
            min-width: 160px;
            padding: 2rem 2rem;
            background: var(--black-card);
            border-right: 1px solid var(--black-border);
        }
            .proof__num:last-child {
                border-right: none;
            }
        .proof__num-n {
            font-family: var(--font-head);
            font-size: 3rem;
            font-weight: 900;
            line-height: 1;
            color: var(--white);
        }
            .proof__num-n .accent {
                color: var(--orange);
            }
        .proof__num-l {
            font-family: var(--font-ui);
            font-size: .7rem;
            letter-spacing: .1em;
            text-transform: uppercase;
            color: var(--white-35);
            margin-top: .35rem;
        }
        /* ═════════ DESCUBRA ════════════════ */
        .disc {
            padding: 8rem 0;
        }
        .disc__inner {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 5rem;
            align-items: center;
        }
        @@media (max-width: 860px) {
            .disc__inner {
                grid-template-columns: 1fr;
            }
        }
        .disc__text {
            display: flex;
            flex-direction: column;
            gap: 1.3rem;
        }
        .disc__mosaic {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            grid-template-rows: repeat(3, 120px);
            gap: 4px;
            border-radius: var(--r-md);
            overflow: hidden;
            border: 1px solid var(--black-border);
        }
        .dm-cell {
            position: relative;
            overflow: hidden;
            transition: transform .4s var(--ease-out);
        }
            .dm-cell:hover {
                transform: scale(.98);
                z-index: 2;
            }
        .dm-cell--tall {
            grid-row: span 2;
        }
        .dm-cell--wide {
            grid-column: span 2;
        }
        .dm-cell__bg {
            position: absolute;
            inset: 0;
        }
        .dc1 .dm-cell__bg {
            background: url("https://image.tmdb.org/t/p/w500/gEU2QniE6E77NI6lCU6MxlSaba7.jpg") center/cover no-repeat;
            filter: brightness(0.7);
        }
        .dc2 .dm-cell__bg {
            background: url("https://image.tmdb.org/t/p/w500/3bhkrj58Vtu7enPvtRG6COoqSjM.jpg") center/cover no-repeat;
            filter: brightness(0.7);
        }
        .dc3 .dm-cell__bg {
            background: url("https://image.tmdb.org/t/p/w500/iuFNm761nb3p98YBMp238v3vXOX.jpg") center/cover no-repeat;
            filter: brightness(0.7);
        }
        .dc4 .dm-cell__bg {
            background: url("https://image.tmdb.org/t/p/w500/8Gxv2mEhG19m2JsCdPmUvCY1Y9r.jpg") center/cover no-repeat;
            filter: brightness(0.7);
        }
        .dc5 .dm-cell__bg {
            background: url("https://image.tmdb.org/t/p/w500/7WsyChQLEUX9Iu033ihMr9uS4GT.jpg") center/cover no-repeat;
            filter: brightness(0.7);
        }
        .dc6 .dm-cell__bg {
            background: url("https://image.tmdb.org/t/p/w500/q6y0Go1tsYKoBbtuou1Al57Z4GZ.jpg") center/cover no-repeat;
            filter: brightness(0.7);
        }
        .dc7 .dm-cell__bg {
            background: url("https://image.tmdb.org/t/p/w500/saF3H9BzbCfDXI4hRQI7DbrAFls.jpg") center/cover no-repeat;
            filter: brightness(0.7);
        }
        .dc8 .dm-cell__bg {
            background: url("https://image.tmdb.org/t/p/w500/d5NXSklfzZqc4tGqys7uLZI9UUE.jpg") center/cover no-repeat;
            filter: brightness(0.7);
        }
        .dc9 .dm-cell__bg {
            background: url("https://image.tmdb.org/t/p/w500/v999867.jpg") center/cover no-repeat;
            filter: brightness(0.7);
        }
        .dm-cell__label {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            padding: .6rem;
            background: linear-gradient(to top, rgba(0,0,0,.9) 0%, transparent 100%);
            font-family: var(--font-head);
            font-size: .7rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .04em;
            color: var(--white-90);
        }
        .dm-cell__score {
            position: absolute;
            top: .4rem;
            right: .4rem;
            background: var(--orange);
            color: #fff;
            font-family: var(--font-head);
            font-size: .65rem;
            font-weight: 800;
            padding: .15rem .4rem;
            border-radius: 3px;
        }
        .genre-pills {
            display: flex;
            flex-wrap: wrap;
            gap: .5rem;
        }
        .gp {
            font-family: var(--font-head);
            font-size: .72rem;
            font-weight: 700;
            letter-spacing: .08em;
            text-transform: uppercase;
            padding: .35rem .85rem;
            border-radius: var(--r-xs);
            border: 1px solid var(--black-border);
            color: var(--white-60);
            background: var(--white-06);
            transition: all .2s var(--ease-out);
        }
            .gp:hover {
                border-color: var(--orange-border);
                color: var(--orange);
                background: var(--orange-glow);
                transform: translateY(-2px);
            }
        /* ══════════  FAVORITOS ═════════════ */
        .wl {
            padding: 8rem 0;
            background: var(--black-deep);
        }
        .wl__inner {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 5rem;
            align-items: center;
        }
        @@media (max-width: 860px) {
            .wl__inner {
                grid-template-columns: 1fr;
            }
            .wl__vis {
                order: -1;
            }
        }
        .wl-mock {
            background: var(--black-card);
            border: 1px solid var(--black-border);
            border-radius: var(--r-lg);
            overflow: hidden;
            box-shadow: 0 32px 80px rgba(0,0,0,.6);
        }
        .wl-mock__bar {
            background: var(--black-lift);
            padding: .9rem 1.2rem;
            border-bottom: 1px solid var(--black-border);
            display: flex;
            align-items: center;
            gap: 1rem;
        }
        .wl-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
        }
        .d-r {
            background: #ff5f57;
        }
        .d-y {
            background: #febc2e;
        }
        .d-g {
            background: #28c840;
        }
        .wl-mock__bartitle {
            font-family: var(--font-head);
            font-size: .75rem;
            font-weight: 600;
            letter-spacing: .06em;
            text-transform: uppercase;
            color: var(--white-35);
            margin-left: .3rem;
        }
        .wl-mock__tabs {
            display: flex;
            gap: 0;
            padding: .75rem 1.2rem 0;
            border-bottom: 1px solid var(--black-border);
        }
        .wl-tab {
            padding: .45rem 1.1rem;
            font-family: var(--font-head);
            font-size: .72rem;
            font-weight: 700;
            letter-spacing: .08em;
            text-transform: uppercase;
            color: var(--white-35);
            border-bottom: 2px solid transparent;
