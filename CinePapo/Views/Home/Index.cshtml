@{

    ViewData["Title"] = "CinePapo — A Comunidade dos Cinéfilos";

    Layout = null;

}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <meta name="description" content="CinePapo é a comunidade premium para quem respira cinema. Resenhas, listas, descobertas e conexões com cinéfilos de verdade." />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/img/favicon.png" />

    <!--FONTS -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,700;1,800&family=Barlow+Condensed:wght@400;500;600;700;800;900&family=Inter:wght@300;400;500&display=swap" rel="stylesheet" />

    <!-- LIBRARIES -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" defer></script>
    <script src="https://unpkg.com/@@phosphor-icons/web@@2.1.0"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <style>
        :root {
            --black: #0a0a0a;
            --black-deep: #050505;
            --black-card: #111111;
            --black-lift: #161616;
            --black-border: #1e1e1e;
            --black-hover: #242424;
            --orange: #E85102;
            --orange-dim: #b83e01;
            --orange-bright: #ff5c0a;
            --orange-glow: rgba(232,81,2,.15);
            --orange-border: rgba(232,81,2,.3);
            --white: #ffffff;
            --white-90: rgba(255,255,255,.9);
            --white-60: rgba(255,255,255,.6);
            --white-35: rgba(255,255,255,.35);
            --white-12: rgba(255,255,255,.12);
            --white-06: rgba(255,255,255,.06);
            --font-head: 'Barlow Condensed', 'Barlow', sans-serif;
            --font-body: 'Barlow', sans-serif;
            --font-ui: 'Inter', system-ui, sans-serif;
            --ease-out: cubic-bezier(.16,1,.3,1);
            --ease-back: cubic-bezier(.34,1.56,.64,1);
            --ease-in-out: cubic-bezier(.65,0,.35,1);
            --r-xs: 4px;
            --r-sm: 8px;
            --r-md: 12px;
            --r-lg: 18px;
            --r-xl: 28px;
        }
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }
        html {
            font-size: 16px;
            scroll-behavior: smooth;
            -webkit-font-smoothing: antialiased;
        }
        body {
            background: var(--black);
            color: var(--white-90);
            font-family: var(--font-body);
            font-weight: 400;
            overflow-x: hidden;
        }
        ::selection {
            background: var(--orange);
            color: #fff;
        }
        img {
            display: block;
            max-width: 100%;
        }
        a {
            text-decoration: none;
            color: inherit;
        }
        button {
            border: none;
            background: none;
            font-family: inherit;
        }
        ul {
            list-style: none;
        }
        /* ═══════ NOISE ═════════ */
        body::after {
            content: '';
            position: fixed;
            inset: 0;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
            opacity: .022;
            pointer-events: none;
            z-index: 9990;
        }
        /* ══════════ SCROLLBAR ═════════════ */
        ::-webkit-scrollbar {
            width: 3px;
        }
        ::-webkit-scrollbar-track {
            background: var(--black);
        }
        ::-webkit-scrollbar-thumb {
            background: var(--orange-dim);
            border-radius: 2px;
        }
        .wrap {
            width: min(1200px, 100% - 3rem);
            margin-inline: auto;
        }
        .pill {
            display: inline-flex;
            align-items: center;
            gap: .45rem;
            font-family: var(--font-head);
            font-size: .72rem;
            font-weight: 700;
            letter-spacing: .14em;
            text-transform: uppercase;
            color: var(--orange);
            padding: .3rem .9rem;
            border: 1px solid var(--orange-border);
            border-radius: var(--r-xs);
            background: var(--orange-glow);
        }
            .pill::before {
                content: '◄';
                font-size: .6rem;
            }
        .sec-title {
            font-family: var(--font-head);
            font-size: clamp(2.6rem, 5.5vw, 5rem);
            font-weight: 900;
            line-height: .95;
            letter-spacing: -.01em;
            text-transform: uppercase;
            color: var(--white);
        }
            .sec-title em {
                font-style: normal;
                color: var(--orange);
            }
        .sec-sub {
            font-family: var(--font-ui);
            font-size: clamp(.88rem, 1.4vw, 1rem);
            color: var(--white-60);
            line-height: 1.75;
            font-weight: 300;
        }
        .divider {
            height: 1px;
            background: var(--black-border);
        }
        [data-r] {
            opacity: 0;
            transform: translateY(24px);
            transition: opacity .7s var(--ease-out), transform .7s var(--ease-out);
        }
            [data-r].on {
                opacity: 1;
                transform: none;
            }
            [data-r][data-d="1"] {
                transition-delay: .08s;
            }
            [data-r][data-d="2"] {
                transition-delay: .16s;
            }
            [data-r][data-d="3"] {
                transition-delay: .24s;
            }
            [data-r][data-d="4"] {
                transition-delay: .32s;
            }
            [data-r][data-d="5"] {
                transition-delay: .40s;
            }
        /* ═════════   BUTTONS ══════════ */
        .btn {
            display: inline-flex;
            align-items: center;
            gap: .6rem;
            font-family: var(--font-head);
            font-size: .9rem;
            font-weight: 700;
            letter-spacing: .06em;
            text-transform: uppercase;
            padding: .85rem 2rem;
            border-radius: var(--r-xs);
            transition: transform .25s var(--ease-out), box-shadow .25s, background .2s;
            position: relative;
            overflow: hidden;
        }
            .btn::before {
                content: '';
                position: absolute;
                inset: 0;
                background: rgba(255,255,255,.08);
                opacity: 0;
                transition: opacity .2s;
            }
            .btn:hover::before {
                opacity: 1;
            }
            .btn:hover {
                transform: translateY(-2px);
            }
            .btn:active {
                transform: translateY(0);
            }
        .btn-orange {
            background: var(--orange);
            color: #fff;
            box-shadow: 0 0 0 0 rgba(232,81,2,0);
        }
            .btn-orange:hover {
                background: var(--orange-bright);
                box-shadow: 0 8px 32px rgba(232,81,2,.35);
            }
        .btn-outline {
            border: 1.5px solid var(--white-12);
            color: var(--white-90);
            background: transparent;
        }
            .btn-outline:hover {
                border-color: var(--white-35);
            }
        .btn-ghost {
            color: var(--orange);
            font-size: .78rem;
            padding: .5rem 0;
            letter-spacing: .08em;
        }
            .btn-ghost i {
                transition: transform .3s var(--ease-back);
            }
            .btn-ghost:hover i {
                transform: translateX(6px);
            }
            .btn-ghost:hover {
                transform: none;
            }
        /* ═════════ NAVBAR ═══════════ */
        .nav {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
            padding: 1.25rem 0;
            transition: background .4s var(--ease-out), padding .4s, border-color .4s;
            border-bottom: 1px solid transparent;
        }
            .nav.scrolled {
                background: rgba(5,5,5,.94);
                backdrop-filter: blur(20px) saturate(1.5);
                padding: .85rem 0;
                border-bottom-color: var(--black-border);
            }
        .nav__inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .nav__logo img {
            height: 20px;
            width: auto;
        }
        .nav__links {
            display: flex;
            align-items: center;
            gap: 2rem;
            margin-left: 2.5rem;
        }
            .nav__links a {
                font-family: var(--font-head);
                font-size: .78rem;
                font-weight: 600;
                letter-spacing: .1em;
                text-transform: uppercase;
                color: var(--white-60);
                transition: color .2s;
                position: relative;
            }
                .nav__links a::after {
                    content: '';
                    position: absolute;
                    bottom: -4px;
                    left: 0;
                    width: 0;
                    height: 2px;
                    background: var(--orange);
                    transition: width .25s var(--ease-out);
                }
                .nav__links a:hover {
                    color: var(--white);
                }
                    .nav__links a:hover::after {
                        width: 100%;
                    }
        .nav__ctas {
            display: flex;
            align-items: center;
            gap: .75rem;
        }
            .nav__ctas .btn {
                padding: .55rem 1.4rem;
                font-size: .75rem;
            }
        .nav__burger {
            display: none;
            flex-direction: column;
            gap: 5px;
            padding: .4rem;
        }
            .nav__burger span {
                width: 22px;
                height: 2px;
                background: var(--white-90);
                display: block;
                transition: all .3s;
            }
        @@media (max-width: 992px) {
            .nav__links {
                display: none;
            }
            .nav__burger {
                display: flex;
            }
            .nav__ctas {
                display: none;
            }
        }
        /* ══════════  HERO ═══════════ */
        .hero {
            min-height: 100svh;
            display: flex;
            align-items: center;
            position: relative;
            overflow: hidden;
        }
        .hero__grid {
            position: absolute;
            inset: 0;
            z-index: 0;
            background-image: linear-gradient(var(--black-border) 1px, transparent 1px), linear-gradient(90deg, var(--black-border) 1px, transparent 1px);
            background-size: 60px 60px;
            mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 30%, transparent 80%);
            -webkit-mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 30%, transparent 80%);
            opacity: .4;
        }
        .hero__blob {
            position: absolute;
            z-index: 0;
            border-radius: 50%;
            background: var(--orange);
            filter: blur(120px);
            opacity: .09;
            pointer-events: none;
        }
        .hero__blob--1 {
            width: 600px;
            height: 600px;
            top: -150px;
            left: -100px;
            animation: blob-drift1 12s ease-in-out infinite;
        }
        .hero__blob--2 {
            width: 400px;
            height: 400px;
            bottom: -100px;
            right: 5%;
            animation: blob-drift2 14s ease-in-out infinite;
        }
        @@keyframes blob-drift1 {
            0%, 100% {
                transform: translate(0,0) scale(1);
            }
            50% {
                transform: translate(60px, 40px) scale(1.1);
            }
        }
        @@keyframes blob-drift2 {
            0%, 100% {
                transform: translate(0,0) scale(1);
            }
            50% {
                transform: translate(-40px,-30px) scale(1.08);
            }
        }
        .hero__bars {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 6vw;
            min-height: 48px;
            background: var(--black-deep);
            z-index: 1;
        }
        .hero__bars--btm {
            top: auto;
            bottom: 0;
        }
        .hero__filmstrip {
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 28px;
            z-index: 2;
            background: var(--black-deep);
            display: flex;
            flex-direction: column;
            justify-content: space-around;
            align-items: center;
            padding: 2rem 0;
        }
        .hero__filmstrip-hole {
            width: 10px;
            height: 14px;
            border-radius: 2px;
            border: 1.5px solid rgba(255,255,255,.1);
        }
        .hero__content {
            position: relative;
            z-index: 3;
            padding-top: 140px;
            padding-bottom: 100px;
            padding-left: 40px;
        }
        .hero__label {
            display: flex;
            align-items: center;
            gap: .8rem;
            margin-bottom: 2rem;
            animation: fade-up .7s .1s var(--ease-out) both;
        }
        .hero__label-bar {
            width: 32px;
            height: 3px;
            background: var(--orange);
        }
        .hero__label-text {
            font-family: var(--font-head);
            font-size: .7rem;
            font-weight: 700;
            letter-spacing: .18em;
            text-transform: uppercase;
            color: var(--orange);
        }
        .hero__title {
            font-family: var(--font-head);
            font-size: clamp(4.5rem, 10vw, 10.5rem);
            font-weight: 900;
            line-height: .9;
            text-transform: uppercase;
            letter-spacing: -.02em;
            margin-bottom: 2rem;
            max-width: 900px;
        }
            .hero__title .line {
                overflow: hidden;
                display: block;
            }
            .hero__title .line-in {
                display: block;
                transform: translateY(110%);
                animation: slide-up .8s var(--ease-out) forwards;
            }
            .hero__title .line:nth-child(2) .line-in {
                animation-delay: .08s;
            }
            .hero__title .line:nth-child(3) .line-in {
                animation-delay: .16s;
            }
        @@keyframes slide-up {
            to {
                transform: translateY(0);
            }
        }
        @@keyframes fade-up {
            from {
                opacity: 0;
                transform: translateY(16px);
            }
            to {
                opacity: 1;
                transform: none;
            }
        }
        .hero__title .t-white {
            color: var(--white);
        }
        .hero__title .t-orange {
            color: var(--orange);
        }
        .hero__title .t-outline {
            color: transparent;
            -webkit-text-stroke: 2px var(--white-35);
        }
        .hero__sub {
            font-family: var(--font-ui);
            font-size: clamp(.95rem, 1.6vw, 1.1rem);
            color: var(--white-60);
            line-height: 1.7;
            font-weight: 300;
            max-width: 480px;
            margin-bottom: 2.8rem;
            animation: fade-up .7s .38s var(--ease-out) both;
        }
        .hero__ctas {
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
            margin-bottom: 4.5rem;
            animation: fade-up .7s .48s var(--ease-out) both;
        }
            .hero__ctas .btn {
                padding: 1.05rem 2.4rem;
                font-size: .88rem;
            }
        .hero__stats {
            display: flex;
            flex-wrap: wrap;
            gap: 2rem;
            margin-top: 4rem;
        }
        .hero__stat {
            padding-right: 2.5rem;
            border-right: 1px solid var(--black-border);
        }
            .hero__stat:last-child {
                border-right: none;
            }
        .hero__stat-n {
            font-family: var(--font-head);
            font-size: 2.2rem;
            font-weight: 800;
            line-height: 1;
            color: var(--white-90);
            display: block;
        }
        .hero__stat-l {
            font-family: var(--font-ui);
            font-size: .68rem;
            letter-spacing: .1em;
            text-transform: uppercase;
            color: var(--white-35);
            margin-top: .4rem;
        }
        @@media (max-width: 768px) {
            .hero__filmstrip {
                display: none;
            }
            .hero__stat {
                padding-right: 0;
                border-right: none;
                width: 100%;
            }
            .hero__title {
                font-size: clamp(2rem, 12vw, 4rem);
            }
        }
        .hero__visual {
            position: absolute;
            right: 5%;
            top: 50%;
            transform: translateY(-48%);
            z-index: 4;
            animation: fade-up .8s .65s var(--ease-out) both;
            display: none;
        }
        @@media (min-width: 1000px) {
            .hero__visual {
                display: block;
            }
        }
        .frc {
            width: 300px;
            background: var(--black-card);
            border: 1px solid var(--black-border);
            border-radius: var(--r-lg);
            overflow: hidden;
            box-shadow: 0 40px 80px rgba(0,0,0,.7);
            animation: frc-float 6s ease-in-out infinite;
        }
        @@keyframes frc-float {
            0%, 100% {
                transform: translateY(0) rotate(.4deg);
            }
            50% {
                transform: translateY(-14px) rotate(-.4deg);
            }
        }
        .frc__head {
            background: var(--black-lift);
            padding: 1rem 1.2rem;
            border-bottom: 1px solid var(--black-border);
            display: flex;
            align-items: center;
            gap: .7rem;
        }
        .frc__poster {
            width: 42px;
            height: 60px;
            border-radius: 4px;
            background: linear-gradient(135deg, #1a0d2e, #0d1240);
            flex-shrink: 0;
        }
            .frc__poster.p2 {
                background: linear-gradient(135deg, #2e0d0d, #1a0808);
            }
            .frc__poster.p3 {
                background: linear-gradient(135deg, #0d2e1a, #081a0d);
            }
        .frc__meta {
            flex: 1;
        }
        .frc__movie {
            font-family: var(--font-head);
            font-size: 1rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .03em;
        }
        .frc__year {
            font-size: .7rem;
            color: var(--white-35);
            margin-top: .1rem;
        }
        .frc__stars {
            color: var(--orange);
            font-size: .75rem;
            margin-top: .2rem;
        }
        .frc__body {
            padding: 1rem 1.2rem;
        }
        .frc__quote {
            font-family: var(--font-ui);
            font-size: .82rem;
            font-style: italic;
            color: var(--white-60);
            line-height: 1.55;
            border-left: 2px solid var(--orange);
            padding-left: .8rem;
        }
        .frc__author {
            display: flex;
            align-items: center;
            gap: .6rem;
            margin-top: .9rem;
        }
        .frc__av {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            flex-shrink: 0;
            font-size: .62rem;
            font-weight: 800;
            display: grid;
            place-items: center;
            color: #fff;
            font-family: var(--font-head);
            text-transform: uppercase;
        }
        .av-o {
            background: var(--orange);
        }
        .av-b {
            background: #0ea5e9;
        }
        .av-p {
            background: #8b5cf6;
        }
        .av-g {
            background: #10b981;
        }
        .av-r {
            background: #ef4444;
        }
        .av-y {
            background: #f59e0b;
        }
        .frc__aname {
            font-size: .78rem;
            font-weight: 600;
        }
        .frc__asub {
            font-size: .65rem;
            color: var(--white-35);
        }
        .frc__likes {
            margin-left: auto;
            font-size: .7rem;
            color: var(--white-35);
            display: flex;
            align-items: center;
            gap: .3rem;
        }
            .frc__likes i {
                color: var(--orange);
                font-size: .65rem;
            }
        .frc__foot {
            padding: .8rem 1.2rem;
            border-top: 1px solid var(--black-border);
            display: flex;
            align-items: center;
            gap: 1.2rem;
        }
        .frc__action {
            font-family: var(--font-head);
            font-size: .68rem;
            font-weight: 700;
            letter-spacing: .1em;
            text-transform: uppercase;
            color: var(--white-35);
            display: flex;
            align-items: center;
            gap: .3rem;
            transition: color .2s;
        }
            .frc__action:hover {
                color: var(--orange);
            }
            .frc__action i {
                font-size: .65rem;
            }
        
            50% {
                transform: translateY(-8px);
            }
        }
        /* ════════ MARQUEE ════════ */
        .marquee {
            padding: 1rem 0;
            background: var(--orange);
            overflow: hidden;
            position: relative;
        }
        .marquee__track {
            display: flex;
            width: max-content;
            animation: marquee-run 22s linear infinite;
        }
            .marquee__track:hover {
                animation-play-state: paused;
            }
        @@keyframes marquee-run {
            to {
                transform: translateX(-50%);
            }
        }
        .marquee__item {
            display: flex;
            align-items: center;
            gap: .6rem;
            padding: 0 2rem;
            white-space: nowrap;
            font-family: var(--font-head);
            font-size: .8rem;
            font-weight: 800;
            letter-spacing: .1em;
            text-transform: uppercase;
            color: #fff;
            flex-shrink: 0;
        }
        .marquee__sep {
            opacity: .5;
        }
        /* ═══════ FEATURES ═════════ */
        .features {
            padding: 8rem 0;
        }
        .features__head {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 1.2rem;
            margin-bottom: 4.5rem;
            max-width: 620px;
        }
        .feat-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1px;
            background: var(--black-border);
            border: 1px solid var(--black-border);
            border-radius: var(--r-md);
            overflow: hidden;
        }
        @@media (max-width: 860px) {
            .feat-grid {
                grid-template-columns: 1fr 1fr;
            }
        }
        @@media (max-width: 560px) {
            .feat-grid {
                grid-template-columns: 1fr;
            }
        }
        .feat-card {
            background: var(--black-card);
            padding: 2.2rem 2rem;
            position: relative;
            overflow: hidden;
            transition: background .3s;
        }
            .feat-card:hover {
                background: var(--black-lift);
            }
            .feat-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
