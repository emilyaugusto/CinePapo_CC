@{
    ViewData["Title"] = "Sobre o CinePapo";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="flex-1 w-full md:max-w-xl lg:max-w-2xl border-r border-white/10 min-h-screen flex flex-col bg-[#0a0a0a]">

    <header class="p-4 border-b border-white/10 flex items-center gap-4 sticky top-0 bg-[#0a0a0a]/90 backdrop-blur-md z-50">
        <a href="javascript:history.back()" class="w-10 h-10 rounded-full hover:bg-white/10 flex items-center justify-center transition-colors">
            <i class="ph-bold ph-arrow-left text-xl text-white"></i>
        </a>
        <h1 class="font-display font-bold text-xl text-white">Sobre o App</h1>
    </header>

    <div class="p-6 md:p-10 flex flex-col items-center text-center mt-6">

        <img src="~/img/logo_comprida.png" alt="CinePapo Logo" class="w-48 md:w-56 mb-8 object-contain">

        <p class="text-gray-300 leading-relaxed mb-10 max-w-md">
            O CinePapo nasceu para ser a sua rede social de cinema preferida. Um espaço desenvolvido com carinho para conectar cinéfilos, compartilhar opiniões e catalogar as histórias que marcam nossas vidas. 🎬🍿
        </p>

        <div class="w-full bg-panel border border-white/5 rounded-3xl p-6 text-left space-y-6 shadow-sm">

            <div>
                <h2 class="font-bold text-white text-lg flex items-center gap-2 mb-2">
                    <i class="ph-fill ph-code text-brand"></i> Versão do Sistema
                </h2>
                <p class="text-sm text-gray-400">Versão 1.2.0 (Beta)</p>
            </div>

            <hr class="border-white/5">

            <div>
                <h2 class="font-bold text-white text-lg flex items-center gap-2 mb-2">
                    <i class="ph-fill ph-database text-blue-500"></i> Tecnologia
                </h2>
                <p class="text-sm text-gray-400">
                    O CinePapo utiliza a poderosa API do TMDB (The Movie Database) para trazer dados precisos sobre milhares de filmes globais.
                </p>
            </div>

            <hr class="border-white/5">

            <div>
                <h2 class="font-bold text-white text-lg flex items-center gap-2 mb-2">
                    <i class="ph-fill ph-rocket-launch text-green-500"></i> Desenvolvedor
                </h2>
                <p class="text-sm text-gray-400">
                    Criado com muita dedicação por Emily Augusto e Thiago freitas.
                </p>
            </div>

        </div>
    </div>
</main>