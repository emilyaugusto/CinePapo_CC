@model CinePapo.Models.Review
@using System.Security.Claims
@{
    var author = ViewBag.Author as CinePapo.Models.User;
    var currentUser = ViewBag.CurrentUser as CinePapo.Models.User;
    string googleId = ViewBag.GoogleId;

    bool isLiked = Model.LikedByUsers != null && currentUser != null &&
                   (Model.LikedByUsers.Contains(currentUser.Id) || (googleId != null && Model.LikedByUsers.Contains(googleId)));

    var commenters = ViewBag.Commenters as List<CinePapo.Models.User>;
    var comments = ViewBag.Comments as List<CinePapo.Models.Comment>;
}

<main class="flex-1 w-full md:max-w-xl lg:max-w-2xl border-r border-white/10 min-h-screen flex flex-col bg-[#0a0a0a] relative">

    <header class="p-4 border-b border-white/10 flex items-center gap-4 sticky top-0 bg-[#0a0a0a]/90 backdrop-blur-md z-50 shadow-sm">
        <a href="javascript:history.back()" class="w-10 h-10 rounded-full hover:bg-white/10 flex items-center justify-center transition-colors">
            <i class="ph-bold ph-arrow-left text-xl text-white"></i>
        </a>
        <h1 class="font-display font-bold text-xl">Resenha</h1>
    </header>

    <div class="p-4 flex flex-col gap-6">
        <!-- CABEÇALHO DA RESENHA: Autor e Botões de Ação -->
        <div class="flex items-start justify-between">

            <a href="/Account/Profile?id=@author?.Id" class="flex items-center gap-3 group w-fit cursor-pointer min-w-0">
                @if (author != null && !string.IsNullOrEmpty(author.ProfilePicture))
                {
                    <img src="@author.ProfilePicture" class="w-12 h-12 rounded-full object-cover border border-white/10 group-hover:border-brand/50 transition-colors">
                }
                else
                {
                    <div class="w-12 h-12 rounded-full bg-brand/20 flex items-center justify-center border border-brand/30 group-hover:border-brand/50 transition-colors">
                        <i class="ph-fill ph-user text-lg text-brand"></i>
                    </div>
                }
                <div>
                    <h3 class="font-bold text-white leading-tight group-hover:text-brand transition-colors">@(author?.Name ?? "Usuário Desconhecido")</h3>
                    <p class="text-xs text-gray-500">&#64;@(author?.Username?.ToLower() ?? "usuario") • @Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</p>
                </div>
            </a>

            <!-- BOTÕES -->
            @if (currentUser != null && (currentUser.Id == Model.UserId))
            {
                <div class="flex gap-1 ml-auto">
                    <a href="/Review/Edit/@Model.Id" class="text-gray-400 hover:text-blue-500 transition-colors p-2 rounded-full hover:bg-blue-500/10" title="Editar resenha">
                        <i class="ph-bold ph-pencil text-lg"></i>
                    </a>
                    <button onclick="showDeleteReviewModal('@Model.Id')" class="text-gray-400 hover:text-red-500 transition-colors p-2 rounded-full hover:bg-red-500/10" title="Apagar resenha">
                        <i class="ph-bold ph-trash text-lg"></i>
                    </button>
                </div>
            }
        </div>

        <!-- Detalhes do Filme -->
        <a href="/Home/Details/@Model.MovieId" class="flex gap-4 p-4 bg-panel/50 border border-white/5 rounded-2xl hover:bg-white/5 transition-colors group">
            @if (!string.IsNullOrEmpty(Model.PosterPath))
            {
                <img src="https://image.tmdb.org/t/p/w200/@Model.PosterPath" class="w-16 md:w-20 rounded-lg object-cover shadow-lg border border-white/5">
            }
            else
            {
                <div class="w-16 md:w-20 h-24 md:h-28 bg-white/5 rounded-lg flex items-center justify-center"><i class="ph ph-film text-gray-500 text-xl"></i></div>
            }

            <div class="flex flex-col justify-center">
                <h2 class="font-bold text-white text-lg md:text-xl leading-tight mb-2 group-hover:text-brand transition-colors">@Model.MovieTitle</h2>
                <div class="flex items-center gap-2">
                    <div class="flex gap-0.5 text-brand text-sm">
                        @for (int i = 1; i <= 5; i++)
                        {
                            if (i <= Model.Rating)
                            {
                                <i class="ph-fill ph-star"></i>
                            }
                            else if (i - 0.5 <= Model.Rating)
                            {
                                <i class="ph-fill ph-star-half"></i>
                            }
                            else
                            {
                                <i class="ph ph-star text-gray-600"></i>
                            }
                        }
                    </div>
                    <span class="font-bold text-white text-sm ml-1">@Model.Rating.ToString("0.0")</span>
                </div>
            </div>
        </a>

        <!-- Conteúdo da Resenha -->
        <div class="border-b border-white/5 pb-8">
            <p class="text-gray-200 leading-relaxed md:text-lg whitespace-pre-line">
                @Model.Content
            </p>

            <div class="flex items-center gap-6 mt-6 text-gray-500">
                <div onclick="toggleLikeDetails(event, '@Model.Id', this)" class="flex items-center gap-2 hover:text-red-500 transition-colors cursor-pointer group">
                    @if (isLiked)
                    {
                        <i class="heart-filled ph-fill ph-heart text-red-500 text-xl"></i>
                        <i class="heart-outline ph ph-heart text-xl hidden"></i>
                    }
                    else
                    {
                        <i class="heart-filled ph-fill ph-heart text-red-500 text-xl hidden"></i>
                        <i class="heart-outline ph ph-heart text-xl"></i>
                    }
                    <span class="text-sm font-medium like-count @(isLiked ? "text-red-500" : "text-white")">@Model.LikesCount Curtidas</span>
                </div>
            </div>
        </div>

        <!-- Seção de Comentários -->
        <section id="comments">
            <h3 class="font-bold text-white mb-6 flex items-center gap-2 text-lg">
                <i class="ph-fill ph-chats text-brand"></i> Comentários (@Model.CommentsCount)
            </h3>

            @if (ViewBag.Comments != null && ViewBag.Comments.Count > 0)
            {
                <div class="space-y-5">
                    @foreach (var comment in ViewBag.Comments)
                    {
                        <div class="flex gap-3">
                            <div class="w-10 h-10 rounded-full bg-brand/10 flex items-center justify-center border border-brand/20 shrink-0">
                                <i class="ph-fill ph-user text-brand"></i>
                            </div>

                            <div class="bg-panel border border-white/5 rounded-2xl rounded-tl-none p-4 flex-1 relative group transition-colors hover:border-white/10">
                                <div class="flex justify-between items-start mb-1">
                                    <div>
                                        <span class="font-bold text-sm text-white">@comment.UserName</span>
                                        <span class="text-[10px] text-gray-500 ml-2">@comment.CreatedAt.ToLocalTime().ToString("dd MMM, HH:mm")</span>
                                    </div>

                                    @if (currentUser != null && (currentUser.Id == comment.UserId || Model.UserId == currentUser.Id))
                                    {
                                        <button onclick="showDeleteCommentModal('@Model.Id', '@comment.Id')"
                                                class="text-gray-500 hover:text-red-500 transition-colors p-1 rounded-full hover:bg-red-500/10 ml-auto" title="Apagar comentário">
                                            <i class="ph-bold ph-trash text-sm"></i>
                                        </button>
                                    }
                                </div>
                                <p class="text-sm text-gray-300">@comment.Content</p>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-gray-500 text-sm">Nenhum comentário por aqui ainda.</p>
            }
        </section>
    </div>

    <div class="sticky bottom-[calc(60px+env(safe-area-inset-bottom))] md:bottom-0 mt-auto w-full bg-[#0a0a0a]/95 backdrop-blur-md border-t border-white/10 p-4 z-40 shadow-[0_-10px_20px_rgba(0,0,0,0.5)]">
        <form action="/Review/AddComment" method="post" class="flex gap-3 items-end">
            <input type="hidden" name="reviewId" value="@Model.Id" />
            <div class="relative flex-1">
                <textarea name="content" required placeholder="Adicione um comentário..." rows="1" autocomplete="off"
                          class="w-full bg-panel rounded-2xl px-5 py-3.5 pr-12 text-sm text-white border border-white/10 outline-none focus:border-brand transition-colors resize-none overflow-hidden"
                          oninput="this.style.height = ''; this.style.height = this.scrollHeight + 'px'"
                          onkeydown="if(event.key === 'Enter' && !event.shiftKey) { event.preventDefault(); this.closest('form').submit(); }"></textarea>
            </div>
            <button type="submit" class="w-12 h-12 shrink-0 bg-brand rounded-full flex items-center justify-center text-white hover:bg-orange-600 transition-colors shadow-lg">
                <i class="ph-bold ph-paper-plane-right text-lg"></i>
            </button>
        </form>
    </div>

    <div id="deleteReviewModal" onclick="hideDeleteReviewModal()" class="fixed inset-0 bg-black/80 backdrop-blur-md z-[110] flex items-center justify-center opacity-0 invisible transition-all duration-300 p-4">
        <div onclick="event.stopPropagation()" class="bg-[#121212] border border-red-500/30 w-full max-w-xs rounded-3xl p-6 text-center shadow-2xl scale-95 transition-transform duration-300">
            <div class="w-14 h-14 bg-red-500/10 rounded-full flex items-center justify-center mx-auto mb-4 border border-red-500/20">
                <i class="ph-bold ph-warning text-2xl text-red-500"></i>
            </div>
            <h3 class="font-display font-black text-white text-lg mb-2">Excluir Resenha?</h3>
            <p class="text-xs text-gray-400 leading-relaxed mb-6">Tem certeza absoluta? Esta ação não pode ser desfeita e você perderá todas as curtidas e comentários.</p>

            <div class="flex flex-col gap-2">
                <button onclick="deleteReview()" class="w-full py-3 bg-red-600 hover:bg-red-700 text-white font-bold text-sm rounded-xl shadow-lg transition-colors">
                    Sim, apagar resenha
                </button>
                <button onclick="hideDeleteReviewModal()" class="w-full py-3 bg-white/5 hover:bg-white/10 text-gray-300 font-bold text-sm rounded-xl transition-colors">
                    Cancelar e Voltar
                </button>
            </div>
        </div>
    </div>

    <div id="deleteCommentModal" onclick="hideDeleteCommentModal()" class="fixed inset-0 bg-black/80 backdrop-blur-md z-[110] flex items-center justify-center opacity-0 invisible transition-all duration-300 p-4">
        <div onclick="event.stopPropagation()" class="bg-[#121212] border border-red-500/30 w-full max-w-xs rounded-3xl p-6 text-center shadow-2xl scale-95 transition-transform duration-300">
            <div class="w-14 h-14 bg-red-500/10 rounded-full flex items-center justify-center mx-auto mb-4 border border-red-500/20">
                <i class="ph-bold ph-trash text-2xl text-red-500"></i>
            </div>
            <h3 class="font-display font-black text-white text-lg mb-2">Apagar Comentário?</h3>
            <p class="text-xs text-gray-400 leading-relaxed mb-6">Seu comentário será removido permanentemente desta resenha.</p>

            <div class="flex flex-col gap-2">
                <button onclick="deleteComment()" class="w-full py-3 bg-red-600 hover:bg-red-700 text-white font-bold text-sm rounded-xl shadow-lg transition-colors">
                    Sim, apagar
                </button>
                <button onclick="hideDeleteCommentModal()" class="w-full py-3 bg-white/5 hover:bg-white/10 text-gray-300 font-bold text-sm rounded-xl transition-colors">
                    Cancelar
                </button>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script>
        let currentReviewIdToDelete = null;
        let currentCommentIdToDelete = null;
        let currentReviewIdForComment = null;

        async function toggleLikeDetails(event, reviewId, element) {
             event.preventDefault();
             event.stopPropagation();

             try {
                 const formData = new FormData();
                 formData.append('reviewId', reviewId);

                 const response = await fetch("/Review/ToggleLike", { method: 'POST', body: formData });
                 const result = await response.json();

                 if (result.success) {
                     const heartOutline = element.querySelector(".heart-outline");
                     const heartFilled = element.querySelector(".heart-filled");
                     const countSpan = element.querySelector(".like-count");

                     if (result.isLiked) {
                         heartOutline.classList.add('hidden');
                         heartFilled.classList.remove('hidden');
                         countSpan.classList.remove('text-white');
                         countSpan.classList.add('text-red-500');
                     } else {
                         heartOutline.classList.remove('hidden');
                         heartFilled.classList.add('hidden');
                         countSpan.classList.remove('text-red-500');
                         countSpan.classList.add('text-white');
                     }

                     countSpan.innerText = result.likesCount + " Curtidas";
                 }
             } catch (e) { console.error("Erro ao curtir", e); }
         }

        // Funções para o Modal de Exclusão de Resenha (Animadas)
        function showDeleteReviewModal(reviewId) {
            currentReviewIdToDelete = reviewId;
            const modal = document.getElementById('deleteReviewModal');
            modal.classList.remove('opacity-0', 'invisible');
            modal.firstElementChild.classList.remove('scale-95');
            modal.firstElementChild.classList.add('scale-100');
        }

        function hideDeleteReviewModal() {
            currentReviewIdToDelete = null;
            const modal = document.getElementById('deleteReviewModal');
            modal.classList.add('opacity-0', 'invisible');
            modal.firstElementChild.classList.remove('scale-100');
            modal.firstElementChild.classList.add('scale-95');
        }

        // Deletar Resenha e Redirecionar
        async function deleteReview() {
            if (!currentReviewIdToDelete) return;

            try {
                const formData = new FormData();
                formData.append('id', currentReviewIdToDelete);

                const response = await fetch("/Review/Delete", { method: 'POST', body: formData });
                const result = await response.json();

                if (result.success) {
                    window.location.href = '/Account/Profile';
                } else {
                    alert(result.message || "Erro ao apagar a resenha.");
                }
            } catch (e) {
                console.error("Erro ao apagar resenha", e);
                alert("Ocorreu um erro ao tentar apagar a resenha.");
            } finally {
                hideDeleteReviewModal();
            }
        }

        // Funções para o Modal de Exclusão de Comentário 
        function showDeleteCommentModal(reviewId, commentId) {
            currentReviewIdForComment = reviewId;
            currentCommentIdToDelete = commentId;
            const modal = document.getElementById('deleteCommentModal');
            modal.classList.remove('opacity-0', 'invisible');
            modal.firstElementChild.classList.remove('scale-95');
            modal.firstElementChild.classList.add('scale-100');
        }

        function hideDeleteCommentModal() {
            currentReviewIdForComment = null;
            currentCommentIdToDelete = null;
            const modal = document.getElementById('deleteCommentModal');
            modal.classList.add('opacity-0', 'invisible');
            modal.firstElementChild.classList.remove('scale-100');
            modal.firstElementChild.classList.add('scale-95');
        }

        async function deleteComment() {
            if (!currentReviewIdForComment || !currentCommentIdToDelete) return;

            try {
                const formData = new FormData();
                formData.append('reviewId', currentReviewIdForComment);
                formData.append('commentId', currentCommentIdToDelete);

                const response = await fetch("/Review/DeleteComment", { method: 'POST', body: formData });
                const result = await response.json();

                if (result.success) {
                    window.location.reload();
                } else {
                    alert(result.message || "Erro ao apagar o comentário.");
                }
            } catch (e) {
                console.error("Erro ao apagar comentário", e);
                alert("Ocorreu um erro ao tentar apagar o comentário.");
            } finally {
                hideDeleteCommentModal();
            }
        }

    </script>
}