@{
    ViewData["Title"] = "Criar Conta - CinePapo";
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-BR" class="bg-[#0a0a0a] text-white">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>

    <link rel="icon" type="image/png" href="/img/favicon.png" />

    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/@@phosphor-icons/web"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Montserrat:wght@700;800;900&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'sans-serif'], display: ['Montserrat', 'sans-serif'] },
                    colors: { brand: '#FF5500', dark: '#0a0a0a', input: '#1A1A1A' }
                }
            }
        }
    </script>
</head>

<body class="antialiased h-[100dvh] flex overflow-hidden">

    <div class="hidden lg:flex lg:w-1/2 relative bg-dark items-center justify-center p-12 h-full border-r border-white/5">
        <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?q=80&w=1920&auto=format&fit=crop')] bg-cover bg-center opacity-20 mix-blend-luminosity"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-dark via-dark/80 to-transparent"></div>
        <div class="absolute -top-40 -left-40 w-96 h-96 bg-brand/20 blur-[100px] rounded-full pointer-events-none"></div>

        <div class="relative z-10 max-w-lg">
            <h2 class="font-display text-5xl font-black leading-tight mb-6">
                A sua opinião <br>
                <span class="text-brand">muda o final.</span>
            </h2>
            <p class="text-gray-400 text-lg mb-8">
                Junte-se a milhares de cinéfilos que não se contentam apenas em assistir. Debata, avalie e construa seu legado cinematográfico no CinePapo.
            </p>

            <div class="flex items-center gap-4 bg-white/5 p-4 rounded-2xl border border-white/10 backdrop-blur-md w-fit">
                <div class="flex -space-x-3">
                    <img class="w-10 h-10 border-2 border-dark rounded-full" src="https://i.pravatar.cc/150?u=10">
                    <img class="w-10 h-10 border-2 border-dark rounded-full" src="https://i.pravatar.cc/150?u=11">
                    <img class="w-10 h-10 border-2 border-dark rounded-full" src="https://i.pravatar.cc/150?u=12">
                </div>
                <div class="text-sm">
                    <p class="font-bold">Mais de 10.000 reviews</p>
                    <p class="text-gray-400 text-xs">A comunidade te espera.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="w-full lg:w-1/2 h-full overflow-y-auto flex flex-col items-center justify-center p-6 relative">

        <div class="w-full max-w-sm flex flex-col items-center my-auto py-8">

            <a href="/" class="flex items-center gap-1 mb-8 group cursor-pointer lg:hidden">
                <span class="font-display text-3xl font-black tracking-tight text-white">CINE</span>
                <i class="ph-fill ph-video-camera text-brand text-2xl"></i>
                <span class="font-display text-3xl font-black tracking-tight text-brand">PAPO</span>
            </a>

            <div class="text-center mb-8 w-full text-left lg:text-center">
                <h1 class="font-display text-2xl font-bold mb-1">Criar conta</h1>
                <p class="text-gray-500 text-sm">Seja bem-vindo(a)!</p>
            </div>

            <form action="/Account/Register" method="post" class="w-full space-y-4">

                @if (ViewBag.ErrorMessage != null)
                {
                    <div class="bg-red-500/10 border border-red-500/50 text-red-500 text-sm font-medium p-3 rounded-lg text-center animate-pulse">
                        @ViewBag.ErrorMessage
                    </div>
                }

                <div>
                    <label class="block text-[10px] font-bold text-gray-400 tracking-wider uppercase mb-2">E-mail</label>
                    <input type="email" name="Email" required placeholder="exemplo@gmail.com" class="w-full bg-input border border-transparent rounded-lg py-3.5 px-4 text-white text-sm placeholder-gray-600 focus:outline-none focus:border-brand focus:ring-1 focus:ring-brand transition-all">
                </div>

                <div>
                    <label class="block text-[10px] font-bold text-gray-400 tracking-wider uppercase mb-2">Senha</label>
                    <input type="password" id="password-input" name="PasswordHash" required minlength="6" placeholder="Mínimo de 6 caracteres" class="w-full bg-input border border-transparent rounded-lg py-3.5 px-4 text-white text-sm placeholder-gray-600 focus:outline-none focus:border-brand focus:ring-1 focus:ring-brand transition-all">

                    <div id="password-strength-container" class="mt-2 hidden">
                        <div class="flex gap-1 h-1 w-full rounded-full overflow-hidden bg-white/10 mb-1">
                            <div id="bar-1" class="h-full w-1/3 transition-all duration-300"></div>
                            <div id="bar-2" class="h-full w-1/3 transition-all duration-300"></div>
                            <div id="bar-3" class="h-full w-1/3 transition-all duration-300"></div>
                        </div>
                        <p id="strength-text" class="text-[10px] font-bold uppercase tracking-wider text-right transition-colors"></p>
                    </div>
                </div>

                <div>
                    <label class="block text-[10px] font-bold text-gray-400 tracking-wider uppercase mb-2">Confirmar Senha</label>
                    <input type="password" name="ConfirmPassword" required minlength="6" placeholder="Repita a senha" class="w-full bg-input border border-transparent rounded-lg py-3.5 px-4 text-white text-sm placeholder-gray-600 focus:outline-none focus:border-brand focus:ring-1 focus:ring-brand transition-all">
                </div>

                <button type="submit" class="w-full py-3.5 mt-4 bg-brand text-white font-medium rounded-lg hover:bg-orange-600 active:scale-[0.98] transition-all">
                    Criar
                </button>

                <div class="relative flex items-center justify-center py-4">
                    <div class="absolute border-t border-white/10 w-full"></div>
                    <span class="bg-dark px-4 text-xs text-gray-500 relative z-10">ou</span>
                </div>

                <a href="/Account/LoginGoogle" class="w-full py-3 bg-transparent border border-white/20 text-white font-medium rounded-lg hover:bg-white/5 active:scale-[0.98] transition-all flex items-center justify-center gap-3">
                    <img src="https://www.svgrepo.com/show/475656/google-color.svg" alt="Google" class="w-5 h-5">
                    <span class="text-sm">Entrar com Google</span>
                </a>
            </form>

            <p class="text-center text-xs text-gray-400 mt-10">
                Já tem uma conta? <a href="/Account/Login" class="text-brand font-bold hover:underline">Entrar agora</a>
            </p>
        </div>
    </div>

    <script>
        document.getElementById('password-input').addEventListener('input', function(e) {
            const pwd = e.target.value;
            const container = document.getElementById('password-strength-container');
            const b1 = document.getElementById('bar-1');
            const b2 = document.getElementById('bar-2');
            const b3 = document.getElementById('bar-3');
            const text = document.getElementById('strength-text');

            if (pwd.length === 0) {
                container.classList.add('hidden');
                return;
            }

            container.classList.remove('hidden');

            let strength = 0;
            if (pwd.length >= 6) strength += 1; 
            if (pwd.length >= 8) strength += 1; 
            if (/[A-Z]/.test(pwd)) strength += 1; 
            if (/[0-9]/.test(pwd)) strength += 1;
            if (/[^A-Za-z0-9]/.test(pwd)) strength += 1; 

            b1.className = 'h-full w-1/3 transition-all duration-300';
            b2.className = 'h-full w-1/3 transition-all duration-300';
            b3.className = 'h-full w-1/3 transition-all duration-300';

            if (strength < 3) {
                b1.classList.add('bg-red-500');
                text.textContent = 'Fraca';
                text.className = 'text-[10px] font-bold uppercase tracking-wider text-right text-red-500';
            } else if (strength === 3 || strength === 4) {
                b1.classList.add('bg-yellow-500');
                b2.classList.add('bg-yellow-500');
                text.textContent = 'Média';
                text.className = 'text-[10px] font-bold uppercase tracking-wider text-right text-yellow-500';
            } else {
                b1.classList.add('bg-green-500');
                b2.classList.add('bg-green-500');
                b3.classList.add('bg-green-500');
                text.textContent = 'Forte';
                text.className = 'text-[10px] font-bold uppercase tracking-wider text-right text-green-500';
            }
        });
    </script>
</body>
</html>