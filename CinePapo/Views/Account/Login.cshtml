@{
    ViewData["Title"] = "Acessar Conta - CinePapo";
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-BR" class="bg-[#0a0a0a] text-white">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>

    <link rel="icon" type="image/png" href="/img/favicon.png" />

    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/@@phosphor-icons/web"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Montserrat:wght@700;800;900&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'sans-serif'], display: ['Montserrat', 'sans-serif'] },
                    colors: { brand: '#FF5500', dark: '#0a0a0a', input: '#1A1A1A' }
                }
            }
        }
    </script>
</head>
<body class="antialiased h-[100dvh] flex overflow-hidden">

    <div class="hidden lg:flex lg:w-1/2 relative bg-dark items-center justify-center p-12 h-full border-r border-white/5">
        <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?q=80&w=1920&auto=format&fit=crop')] bg-cover bg-center opacity-20 mix-blend-luminosity"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-dark via-dark/80 to-transparent"></div>
        <div class="absolute -top-40 -left-40 w-96 h-96 bg-brand/20 blur-[100px] rounded-full pointer-events-none"></div>

        <div class="relative z-10 max-w-lg">
            <h2 class="font-display text-5xl font-black leading-tight mb-6">
                A sessão vai <br>
                <span class="text-brand">começar.</span>
            </h2>
            <p class="text-gray-400 text-lg mb-8">
                Pegue sua pipoca, acesse sua conta e venha defender o seu filme favorito com a nossa comunidade.
            </p>

            <div class="flex items-center gap-4 bg-white/5 p-4 rounded-2xl border border-white/10 backdrop-blur-md w-fit">
                <i class="ph-duotone ph-popcorn text-4xl text-brand"></i>
                <div class="text-sm">
                    <p class="font-bold">Sua poltrona está reservada</p>
                    <p class="text-gray-400 text-xs">Bem-vindo de volta ao CinePapo.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="w-full lg:w-1/2 h-full overflow-y-auto flex flex-col items-center justify-center p-6 relative">

        <div class="w-full max-w-sm flex flex-col items-center my-auto py-8">

            <a href="/" class="flex items-center gap-1 mb-8 group cursor-pointer lg:hidden">
                <span class="font-display text-3xl font-black tracking-tight text-white">CINE</span>
                <i class="ph-fill ph-video-camera text-brand text-2xl"></i>
                <span class="font-display text-3xl font-black tracking-tight text-brand">PAPO</span>
            </a>

            <div class="text-center mb-8 w-full text-left lg:text-center">
                <h1 class="font-display text-2xl font-bold mb-1">Acessar conta</h1>
                <p class="text-gray-500 text-sm">Que bom te ver novamente.</p>
            </div>

            <form action="/Account/Login" method="post" class="w-full space-y-4">

                @if (ViewBag.ErrorMessage != null)
                {
                    <div class="bg-red-500/10 border border-red-500/50 text-red-500 text-sm font-medium p-3 rounded-xl text-center animate-pulse mb-4">
                        @ViewBag.ErrorMessage
                    </div>
                }

                <div>
                    <label class="block text-[10px] font-bold text-gray-400 tracking-wider uppercase mb-2">E-mail</label>
                    <input type="email" name="email" required placeholder="exemplo@gmail.com" class="w-full bg-input border border-transparent rounded-lg py-3.5 px-4 text-white text-sm placeholder-gray-600 focus:outline-none focus:border-brand focus:ring-1 focus:ring-brand transition-all">
                </div>

                <div>
                    <div class="flex justify-between items-center mb-2">
                        <label class="block text-[10px] font-bold text-gray-400 tracking-wider uppercase">Senha</label>
                        <a href="#" class="text-[10px] font-bold text-brand hover:text-white transition-colors">Esqueceu a senha?</a>
                    </div>
                    <input type="password" name="password" required placeholder="••••••••••" class="w-full bg-input border border-transparent rounded-lg py-3.5 px-4 text-white text-sm placeholder-gray-600 focus:outline-none focus:border-brand focus:ring-1 focus:ring-brand transition-all">
                </div>

                <button type="submit" class="w-full py-3.5 mt-4 bg-brand text-white font-medium rounded-lg hover:bg-orange-600 active:scale-[0.98] transition-all">
                    Entrar
                </button>

                <div class="relative flex items-center justify-center py-4">
                    <div class="absolute border-t border-white/10 w-full"></div>
                    <span class="bg-dark px-4 text-xs text-gray-500 relative z-10">ou</span>
                </div>

                <a href="/Account/LoginGoogle" class="w-full py-3 bg-transparent border border-white/20 text-white font-medium rounded-lg hover:bg-white/5 active:scale-[0.98] transition-all flex items-center justify-center gap-3">
                    <img src="https://www.svgrepo.com/show/475656/google-color.svg" alt="Google" class="w-5 h-5">
                    <span class="text-sm">Entrar com Google</span>
                </a>
            </form>

            <p class="text-center text-xs text-gray-400 mt-8">
                Ainda não tem conta? <a href="/Account/Register" class="text-brand font-bold hover:underline">Criar agora</a>
            </p>
        </div>
    </div>

</body>
</html>